---
import type { Lang } from "../i18n/ui";
import { useTranslations, routePath } from "../i18n/utils";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const testHref = `${routePath(lang, "contact")}?topic=placement#form`;
---

<section class="gfe-cta">
    <div class="container">
        <div class="gfe-cta__inner">
            <div class="gfe-cta__text">
                <h2 class="gfe-cta__title">{t("cta.title")}</h2>
                <p>{t("cta.text")}</p>
            </div>
            <div class="gfe-cta__actions">
                <a href={testHref} class="rts-theme-btn btn-arrow">{t("cta.btn")} <span><i class="fa-light fa-arrow-right"></i></span></a>
                <a href={routePath(lang, "catalogue")} class="gfe-cta__alt">{t("cta.alt")} <i class="fa-light fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>
