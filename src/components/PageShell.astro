---
import type { Lang } from "../i18n/ui";
import { useTranslations, routePath } from "../i18n/utils";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { bannerFor } from "./banners";
import CtaBand from "./CtaBand.astro";
import { courseArtworkFor } from "../data/course-artwork";
import { breadcrumbSchema, homeLabel } from "../seo/schema";
import type { RouteKey } from "../i18n/routes";

interface Props {
	lang: Lang;
	title: string;
	description?: string;
	metaDescription?: string;
	pageKey?: string;
	sample?: boolean;
	ogImage?: string;
	bare?: boolean;
	noCta?: boolean;
	/** Route key of the section this page belongs to (adds a middle breadcrumb). */
	parentKey?: string;
	/** Extra JSON-LD objects (Course, Article, FAQPage...). */
	schema?: unknown[];
	ogType?: "website" | "article";
}
const { lang, title, description, metaDescription, pageKey, sample, ogImage, bare, noCta, parentKey: parentProp, schema = [], ogType } = Astro.props;
const t = useTranslations(lang);
const banner = bannerFor(pageKey);
const courseArt = courseArtworkFor(pageKey);
const bannerImage = courseArt?.src ?? `/images/photos/banner-${banner}.webp`;

// Breadcrumb: Home > (section) > page. Sections are inferred from the key prefix unless given.
const inferredParent = pageKey?.startsWith("courses/") ? "catalogue" : pageKey?.startsWith("bundles/") ? "bundles" : pageKey?.startsWith("exams/") ? "exams" : undefined;
const parentKey = parentProp ?? inferredParent;
const parentLabel = parentKey ? t(({ catalogue: "nav.c.catalogue", bundles: "nav.c.bundles", exams: "nav.e.exams", news: "nav.news" } as Record<string, string>)[parentKey] as any) : undefined;
const crumbs = [
	{ name: homeLabel(lang), url: routePath(lang, "home") },
	...(parentKey && parentLabel ? [{ name: parentLabel, url: routePath(lang, parentKey as RouteKey) }] : []),
	{ name: title, url: Astro.url.pathname },
];
const jsonLd = [breadcrumbSchema(crumbs), ...schema];
---

<Layout lang={lang} title={`${title} | Global French Education`} description={metaDescription ?? description} noindex={sample} image={ogImage ?? courseArt?.src} schema={jsonLd} ogType={ogType}>
<Header lang={lang} />
<main id="main">

    {!bare && (
    <section class:list={["gfe-banner", { "gfe-banner--course": Boolean(courseArt), "gfe-banner--course-split": courseArt?.split }]} style={courseArt?.split ? undefined : `background-image: url(${bannerImage});`}>
        <div class="container">
            <div class="gfe-banner__inner">
                <nav class="gfe-banner__crumb" aria-label="Breadcrumb">
                    <a href={routePath(lang, "home")}>{t("nav.home")}</a>
                    <span aria-hidden="true">/</span>
                    {parentKey && parentLabel && (<><a href={routePath(lang, parentKey as RouteKey)}>{parentLabel}</a><span aria-hidden="true">/</span></>)}
                    <span aria-current="page">{title}</span>
                </nav>
                <h1 class="gfe-banner__title">{title}</h1>
                {description && <p class="gfe-banner__sub">{description}</p>}
            </div>
        </div>
        {courseArt?.split && <img class="gfe-banner__course-art" src={courseArt.src} alt="" width="1200" height="900" loading="eager" decoding="async" />}
    </section>
    )}

    <slot />

    {!noCta && <CtaBand lang={lang} />}

</main>
<Footer lang={lang} />
</Layout>
