---
import type { Lang } from "../i18n/ui";
import { useTranslations, routePath } from "../i18n/utils";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Submissions go straight to Web3Forms (https://web3forms.com), which e-mails the address the access key was created with.
// The access key is public by design (it only identifies the inbox); spam is filtered by the hidden botcheck field and Web3Forms.
const WEB3FORMS_KEY = "904417f7-075c-4f37-9ee9-5a0e19548790";
const topics = [
	["placement", "form.topic.placement"],
	["courses", "form.topic.courses"],
	["enroll", "form.topic.enroll"],
	["exam", "form.topic.exam"],
	["corporate", "form.topic.corporate"],
	["other", "form.topic.other"],
] as const;
---

<section class="gfe-form" id="form">
	<h2>{t("form.title")}</h2>
	<form
		method="post"
		action="https://api.web3forms.com/submit"
		data-lang={lang}
		data-sending={t("form.sending")}
		data-success={t("form.success")}
		data-error={t("form.error")}
	>
		<input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
		<input type="hidden" name="from_name" value="Site igedu.ca" />
		<input type="hidden" name="subject" value="[igedu.ca] Nouveau message" />
		<input type="hidden" name="language" value={lang} />
		<div class="gfe-form__row">
			<label>{t("form.name")} <input type="text" name="name" required maxlength="120" autocomplete="name" /></label>
			<label>{t("form.email")} <input type="email" name="email" required maxlength="160" autocomplete="email" /></label>
		</div>
		<div class="gfe-form__row">
			<label>{t("form.phone")} <input type="tel" name="phone" maxlength="40" autocomplete="tel" /></label>
			<label>{t("form.topic")}
				<select name="topic" required>
					{topics.map(([value, key]) => <option value={value}>{t(key)}</option>)}
				</select>
			</label>
		</div>
		<label>{t("form.message")} <textarea name="message" rows="5" maxlength="4000"></textarea></label>
		<!-- honeypot (Web3Forms "botcheck"): real visitors never see or tick this -->
		<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" class="gfe-form__trap" aria-hidden="true" />
		<label class="gfe-form__consent">
			<input type="checkbox" name="consent" required />
			<span>{t("form.consent")} <a href={routePath(lang, "privacy")}>{t("form.privacy")}</a></span>
		</label>
		<button type="submit" class="rts-theme-btn">{t("form.submit")}</button>
		<p class="gfe-form__status" role="status" aria-live="polite"></p>
	</form>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>(".gfe-form form");
	if (form) {
		const status = form.querySelector<HTMLElement>(".gfe-form__status")!;
		const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
		// /contact?topic=placement preselects the topic
		const wanted = new URLSearchParams(location.search).get("topic");
		const select = form.querySelector<HTMLSelectElement>("select[name=topic]")!;
		if (wanted && [...select.options].some((o) => o.value === wanted)) select.value = wanted;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			// Send the readable topic label, and put it in the e-mail subject
			const topicLabel = select.selectedOptions[0]?.text ?? String(data.get("topic"));
			data.set("topic", topicLabel);
			data.set("subject", `[igedu.ca] ${topicLabel} – ${data.get("name")}`);
			data.set("consent", data.get("consent") === "on" ? "oui" : "non");
			button.disabled = true;
			status.className = "gfe-form__status";
			status.textContent = form.dataset.sending ?? "";
			try {
				const response = await fetch(form.action, { method: "POST", body: data, headers: { accept: "application/json" } });
				const result = await response.json().catch(() => ({}));
				if (!response.ok || !result.success) throw new Error(String(response.status));
				form.reset();
				status.classList.add("is-success");
				status.textContent = form.dataset.success ?? "";
			} catch {
				status.classList.add("is-error");
				status.textContent = form.dataset.error ?? "";
			} finally {
				button.disabled = false;
			}
		});
	}
</script>
