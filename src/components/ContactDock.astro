---
import type { Lang } from "../i18n/ui";
import { useTranslations, routePath } from "../i18n/utils";
import { site } from "../i18n/site";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const phoneHref = `tel:${site.phone.replace(/[^\d+]/g, "")}`;
const waHref = site.whatsapp ? `https://wa.me/${site.whatsapp}` : "";
---

<nav class="gfe-dock" aria-label="Contact">
	{waHref && <a href={waHref} rel="noopener" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>}
	{site.phone && <a href={phoneHref}><i class="fa-light fa-phone"></i> {t("dock.call")}</a>}
	<a href={`${routePath(lang, "contact")}#form`}><i class="fa-light fa-envelope"></i> {t("dock.write")}</a>
</nav>
