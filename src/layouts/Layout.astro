---
import type { Lang } from "../i18n/ui";
import { langList } from "../i18n/langs";
import { switchLangPath } from "../i18n/utils";
import { site } from "../i18n/site";
import { useTranslations } from "../i18n/utils";
import ContactDock from "../components/ContactDock.astro";
import "../styles/custom.css";
import "../styles/redesign.css";
import { organizationSchema } from "../seo/schema";

interface Props {
	title: string;
	lang: Lang;
	description?: string;
	noindex?: boolean;
	image?: string;
	/** Extra JSON-LD objects for this page (the organization is always included). */
	schema?: unknown[];
	ogType?: "website" | "article";
}
const { title, lang, description, noindex, image: imagePath, schema = [], ogType = "website" } = Astro.props;
const jsonLd = [organizationSchema(lang), ...schema];
const t = useTranslations(lang);
const image = new URL(imagePath ?? "/images/photos/og.jpg", site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;
const locale = { fr: "fr_CA", en: "en_CA" }[lang];

---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={canonical} />
		{langList.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLangPath(Astro.url, l), site.url).href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(switchLangPath(Astro.url, "fr"), site.url).href} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale} />
		<meta property="og:image" content={image} />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={image} />
		<meta name="theme-color" content="#0055A4" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href="/assets/fonts/inter-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/assets/fonts/fraunces-normal-600-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="stylesheet" href="/assets/css/fonts.css" />
		<link rel="stylesheet" href="/assets/css/plugins/fontawesome.min.css" />
		<link rel="stylesheet" href="/assets/css/vendor/bootstrap.min.css" />
		<link rel="stylesheet" href="/assets/css/style.css" />
		{jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
	</head>
	<body class="page">
		<a class="gfe-skip" href="#main">{t("a11y.skip")}</a>
		<slot />
		<ContactDock lang={lang} />

		<script is:inline defer src="/assets/js/site.js"></script>
		<script is:inline>
		// Subtle scroll-reveal for cards and content blocks (no-JS: everything stays visible).
		(() => {
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			const els = Array.from(document.querySelectorAll(
				".gfe-course-card, .gfe-news-card, .gfe-teacher, .gfe-story, .gfe-program, .gfe-claim, .gfe-stats li"
			));
			if (!els.length) return;
			els.forEach((el, i) => {
				el.classList.add("gfe-reveal");
				el.style.transitionDelay = `${(i % 4) * 70}ms`;
			});
			const show = () => {
				const vh = window.innerHeight;
				for (const el of els) {
					if (el.classList.contains("is-in")) continue;
					const r = el.getBoundingClientRect();
					if (r.top < vh - 40 && r.bottom > 0) el.classList.add("is-in");
				}
			};
			const onScroll = () => show();
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll, { passive: true });
			show();
			setTimeout(show, 400);
		})();
		</script>
	</body>
</html>
